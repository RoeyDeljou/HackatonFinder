{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/search.js": { "maxDuration": 300 },
    "api/cron.js": { "maxDuration": 300 },
    "api/profile.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron?job=search&slot=morning", "schedule": "0 5 * * *" },
    { "path": "/api/cron?job=search&slot=afternoon", "schedule": "0 12 * * *" },
    { "path": "/api/cron?job=digest", "schedule": "0 18 * * *" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
