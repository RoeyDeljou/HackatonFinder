# --- Required: Web Push (generate with `npm run vapid`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Required on Vercel: storage (Upstash Redis, free tier is enough) ---
# Adding Upstash from the Vercel Marketplace sets these (or KV_REST_API_URL / KV_REST_API_TOKEN) for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Required on Vercel: protects /api/cron (any long random string) ---
CRON_SECRET=

# --- Optional, FREE: AI web search (LinkedIn, company sites, news) via Gemini + Google Search ---
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional, FREE: extra LinkedIn/web feed (1,000 searches/month free, app stays under 900) ---
# Free key: https://app.tavily.com
TAVILY_API_KEY=
# TAVILY_MONTHLY_BUDGET=900

# --- Optional, PAID alternative to Gemini: Claude web search ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=gemini   # force one: gemini | anthropic | off

# --- Optional: self-hosting without Vercel Cron (node server.js) ---
# SCHEDULER=on
# SCHEDULE_TZ=Asia/Jerusalem
# SCHEDULE_MORNING=10:00
# SCHEDULE_AFTERNOON=18:00
# SCHEDULE_DIGEST=21:00
